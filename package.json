{
  "name": "openmock",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node tests/all.test.mjs",
    "check:boundaries": "depcruise --config .dependency-cruiser.cjs src",
    "check:size": "scc src --by-file --sort code --no-cocomo --no-complexity --no-gen --exclude-dir node_modules,.next,out,build,dist,coverage,tests --exclude-file next-env.d.ts --exclude-ext ico,svg --not-match \"\\.(test|spec)\\.|\\.d\\.[cm]?ts$\"",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:boundaries"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.125",
    "@ai-sdk/openai": "^3.0.120",
    "@base-ui/react": "^1.8.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@monaco-editor/react": "^4.7.0",
    "@shadcn/react": "^0.3.1",
    "ai": "^6.0.295",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "js-yaml": "^5.4.2",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "ollama-ai-provider-v2": "^3.6.0",
    "pino": "^10.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.14.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
