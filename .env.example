OPENMOCK_AI_PROVIDER=ollama
OPENMOCK_AI_MODEL=qwen3:8b
OPENMOCK_DISABLED_INTERVIEWS=

# Local Speech (Docker Compose); independent of the AI provider.
WHISPER_MODEL=base.en
KOKORO_VOICE=af_heart
SPEECH_CPU_THREADS=4
SPEECH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOG_LEVEL=debug
LOG_TO_FILE=false
LOG_FILE=./logs/openmock.log
